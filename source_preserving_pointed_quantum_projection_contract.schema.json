{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boe.example/mtt/source-preserving-pointed-quantum-projection.v1.schema.json",
  "title": "MTT source-preserving pointed quantum projection and Ward nonselection packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "date",
    "status",
    "source_provenance",
    "finite_counterterm_orbit",
    "ward_qme_ppa_nonselection",
    "source_preserving_projection_contract",
    "selection_theorem",
    "radial_state_route",
    "T35_execution",
    "QJ_classification",
    "parameter_ledger",
    "physical_boundary",
    "physical_packets_accepted",
    "physical_packets_total",
    "physical_rows_accepted",
    "physical_rows_total",
    "frontier_delta",
    "checks",
    "check_summary"
  ],
  "properties": {
    "schema": {"const": "boe.mtt.source-preserving-pointed-quantum-projection.v1"},
    "claim_id": {"const": "CBF.T40"},
    "date": {"type": "string"},
    "status": {"type": "string"},
    "source_provenance": {"type": "object"},
    "finite_counterterm_orbit": {"type": "object"},
    "ward_qme_ppa_nonselection": {"type": "object"},
    "source_preserving_projection_contract": {"type": "object"},
    "selection_theorem": {"type": "object"},
    "radial_state_route": {"type": "object"},
    "T35_execution": {"type": "object"},
    "QJ_classification": {"type": "object"},
    "parameter_ledger": {"type": "object"},
    "physical_boundary": {"type": "object"},
    "physical_packets_accepted": {"const": 0},
    "physical_packets_total": {"const": 3},
    "physical_rows_accepted": {"const": 0},
    "physical_rows_total": {"const": 7},
    "frontier_delta": {"type": "string"},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "check_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total", "failed"],
      "properties": {
        "passed": {"type": "integer", "minimum": 1},
        "total": {"type": "integer", "minimum": 1},
        "failed": {"type": "array", "maxItems": 0}
      }
    }
  }
}
