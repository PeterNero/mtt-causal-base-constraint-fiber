{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boe.example/mtt/finite-dirac-cubic-variational-action.v1.schema.json",
  "title": "MTT finite Dirac cubic variational-action packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "date",
    "status",
    "source_provenance",
    "configuration_space",
    "direct_variational_action",
    "critical_locus",
    "signed_Hessian",
    "Morse_Bott_decomposition",
    "normal_square_bridge",
    "automorphism_transfer",
    "KO6_cancellation",
    "weighted_anchor_escape_test",
    "canonical_two_anchor_classification",
    "action_tier_reconciliation",
    "parameter_ledger",
    "physical_boundary",
    "physical_packets_accepted",
    "physical_packets_total",
    "physical_rows_accepted",
    "physical_rows_total",
    "frontier_delta",
    "checks",
    "check_summary"
  ],
  "properties": {
    "schema": {"const": "boe.mtt.finite-dirac-cubic-variational-action.v1"},
    "claim_id": {"const": "CBF.T29"},
    "date": {"type": "string"},
    "status": {"type": "string"},
    "source_provenance": {"type": "object"},
    "configuration_space": {"type": "object"},
    "direct_variational_action": {"type": "object"},
    "critical_locus": {"type": "object"},
    "signed_Hessian": {"type": "object"},
    "Morse_Bott_decomposition": {"type": "object"},
    "normal_square_bridge": {"type": "object"},
    "automorphism_transfer": {"type": "object"},
    "KO6_cancellation": {"type": "object"},
    "weighted_anchor_escape_test": {"type": "object"},
    "canonical_two_anchor_classification": {"type": "object"},
    "action_tier_reconciliation": {"type": "object"},
    "parameter_ledger": {"type": "object"},
    "physical_boundary": {"type": "object"},
    "physical_packets_accepted": {"const": 0},
    "physical_packets_total": {"const": 3},
    "physical_rows_accepted": {"const": 0},
    "physical_rows_total": {"const": 7},
    "frontier_delta": {"type": "string"},
    "checks": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "check_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total", "failed"],
      "properties": {
        "passed": {"type": "integer", "minimum": 1},
        "total": {"type": "integer", "minimum": 1},
        "failed": {"type": "array", "maxItems": 0}
      }
    }
  }
}
