{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boe.mtt.physical-yukawa-hessian.v1",
  "title": "CBF.T23 physical Yukawa Hessian identification packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "date",
    "tier",
    "source_lock_sha256",
    "contract_schema_sha256",
    "theorem_sha256",
    "physical_completion_sha256",
    "source_provenance",
    "carrier_and_incidence",
    "one_higgs_gauge_covariance",
    "physical_dirac_family",
    "hessian_compression",
    "lorentzian_product_and_scale",
    "parameter_ledger",
    "endpoint_classification",
    "physical_boundary",
    "physical_packets_accepted",
    "physical_packets_total",
    "physical_rows_accepted",
    "physical_rows_total",
    "frontier_delta",
    "checks",
    "check_summary"
  ],
  "properties": {
    "schema": {"const": "boe.mtt.physical-yukawa-hessian.v1"},
    "claim_id": {"const": "CBF.T23"},
    "date": {"type": "string"},
    "tier": {"type": "string"},
    "source_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "theorem_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "physical_completion_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_provenance": {"type": "object"},
    "carrier_and_incidence": {"type": "object"},
    "one_higgs_gauge_covariance": {"type": "object"},
    "physical_dirac_family": {"type": "object"},
    "hessian_compression": {"type": "object"},
    "lorentzian_product_and_scale": {"type": "object"},
    "parameter_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_observed_inputs",
        "new_fitted_coefficients",
        "new_dimensionless_shape_parameters",
        "shared_source_coordinates",
        "universal_dimensionful_primitives",
        "sector_specific_scale_parameters"
      ],
      "properties": {
        "new_observed_inputs": {"const": 0},
        "new_fitted_coefficients": {"const": 0},
        "new_dimensionless_shape_parameters": {"const": 0},
        "shared_source_coordinates": {"const": 1},
        "universal_dimensionful_primitives": {"const": 1},
        "sector_specific_scale_parameters": {"const": 0}
      }
    },
    "endpoint_classification": {"type": "object"},
    "physical_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finite_physical_Yukawa_Laplacian_typed",
        "full_selected_Lorentz_Higgs_Yukawa_endpoint",
        "upper_MTT_composite_root_selected",
        "numerical_Higgs_vacuum_selected",
        "continuum_HYM_intertwiner",
        "physical_BV4_pushforward",
        "scalar_Higgs_potential_Hessian_claimed",
        "first_order_fermionic_action_replaced",
        "eta9_or_new_worker_used"
      ],
      "properties": {
        "finite_physical_Yukawa_Laplacian_typed": {"const": true},
        "full_selected_Lorentz_Higgs_Yukawa_endpoint": {"const": false},
        "upper_MTT_composite_root_selected": {"const": false},
        "numerical_Higgs_vacuum_selected": {"const": false},
        "continuum_HYM_intertwiner": {"const": false},
        "physical_BV4_pushforward": {"const": false},
        "scalar_Higgs_potential_Hessian_claimed": {"const": false},
        "first_order_fermionic_action_replaced": {"const": false},
        "eta9_or_new_worker_used": {"const": false}
      }
    },
    "physical_packets_accepted": {"const": 0},
    "physical_packets_total": {"const": 3},
    "physical_rows_accepted": {"const": 0},
    "physical_rows_total": {"const": 7},
    "frontier_delta": {"type": "string"},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "check_summary": {
      "type": "object",
      "required": ["passed", "total", "failed"],
      "properties": {
        "passed": {"type": "integer"},
        "total": {"type": "integer"},
        "failed": {"type": "array", "maxItems": 0}
      }
    }
  }
}
