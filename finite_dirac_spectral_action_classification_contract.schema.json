{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boe.example/mtt/finite-dirac-spectral-action-classification.v1.schema.json",
  "title": "MTT finite Dirac spectral-action classification packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "date",
    "status",
    "source_provenance",
    "finite_source",
    "exact_factorization",
    "joint_spectrum",
    "full_spectrum",
    "spectral_functional",
    "profile_examples",
    "heat_profile_no_go",
    "profile_selection_no_go",
    "coordinate_interpretation",
    "action_boundary",
    "parameter_ledger",
    "physical_boundary",
    "physical_packets_accepted",
    "physical_packets_total",
    "physical_rows_accepted",
    "physical_rows_total",
    "frontier_delta",
    "checks",
    "check_summary"
  ],
  "properties": {
    "schema": {"const": "boe.mtt.finite-dirac-spectral-action-classification.v1"},
    "claim_id": {"const": "CBF.T27"},
    "date": {"type": "string"},
    "status": {"type": "string"},
    "source_provenance": {"type": "object"},
    "finite_source": {"type": "object"},
    "exact_factorization": {"type": "object"},
    "joint_spectrum": {"type": "object"},
    "full_spectrum": {"type": "object"},
    "spectral_functional": {"type": "object"},
    "profile_examples": {"type": "object"},
    "heat_profile_no_go": {"type": "object"},
    "profile_selection_no_go": {"type": "object"},
    "coordinate_interpretation": {"type": "object"},
    "action_boundary": {"type": "object"},
    "parameter_ledger": {"type": "object"},
    "physical_boundary": {"type": "object"},
    "physical_packets_accepted": {"const": 0},
    "physical_packets_total": {"const": 3},
    "physical_rows_accepted": {"const": 0},
    "physical_rows_total": {"const": 7},
    "frontier_delta": {"type": "string"},
    "checks": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "check_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total", "failed"],
      "properties": {
        "passed": {"type": "integer", "minimum": 1},
        "total": {"type": "integer", "minimum": 1},
        "failed": {"type": "array", "maxItems": 0}
      }
    }
  }
}
