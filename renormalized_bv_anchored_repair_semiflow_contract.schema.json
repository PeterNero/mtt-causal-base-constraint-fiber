{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boe.example/mtt/renormalized-bv-anchored-repair-semiflow.v1.schema.json",
  "title": "MTT renormalized BV anchored repair-semiflow packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "date",
    "status",
    "source_provenance",
    "quantum_bv_generator",
    "q79_source_coverage",
    "global_intertwining_no_go",
    "pointed_anchor_retraction",
    "anchored_formal_bv_flow",
    "T35_pointed_execution",
    "qme_and_ward_compatibility",
    "QJ_classification",
    "parameter_ledger",
    "physical_boundary",
    "physical_packets_accepted",
    "physical_packets_total",
    "physical_rows_accepted",
    "physical_rows_total",
    "frontier_delta",
    "checks",
    "check_summary"
  ],
  "properties": {
    "schema": {"const": "boe.mtt.renormalized-bv-anchored-repair-semiflow.v1"},
    "claim_id": {"const": "CBF.T39"},
    "date": {"type": "string"},
    "status": {"type": "string"},
    "source_provenance": {"type": "object"},
    "quantum_bv_generator": {"type": "object"},
    "q79_source_coverage": {"type": "object"},
    "global_intertwining_no_go": {"type": "object"},
    "pointed_anchor_retraction": {"type": "object"},
    "anchored_formal_bv_flow": {"type": "object"},
    "T35_pointed_execution": {"type": "object"},
    "qme_and_ward_compatibility": {"type": "object"},
    "QJ_classification": {"type": "object"},
    "parameter_ledger": {"type": "object"},
    "physical_boundary": {"type": "object"},
    "physical_packets_accepted": {"const": 0},
    "physical_packets_total": {"const": 3},
    "physical_rows_accepted": {"const": 0},
    "physical_rows_total": {"const": 7},
    "frontier_delta": {"type": "string"},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "check_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total", "failed"],
      "properties": {
        "passed": {"type": "integer", "minimum": 1},
        "total": {"type": "integer", "minimum": 1},
        "failed": {"type": "array", "maxItems": 0}
      }
    }
  }
}
