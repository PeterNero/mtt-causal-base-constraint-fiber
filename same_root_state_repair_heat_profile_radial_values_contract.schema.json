{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boe.example/mtt/same-root-state-repair-heat-profile-radial-values.v1.schema.json",
  "title": "MTT same-root state-repair heat-profile and radial-value promotion packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "date",
    "status",
    "source_provenance",
    "same_root_commuting_diagram",
    "state_space_quadratic_repair",
    "action_shadow_bridge",
    "heat_profile_selection",
    "positive_laplace_measure",
    "spectral_moments",
    "selected_internal_checkpoint",
    "promoted_radial_values",
    "typed_no_go_reconciliation",
    "parameter_ledger",
    "physical_boundary",
    "physical_packets_accepted",
    "physical_packets_total",
    "physical_rows_accepted",
    "physical_rows_total",
    "frontier_delta",
    "checks",
    "check_summary"
  ],
  "properties": {
    "schema": {"const": "boe.mtt.same-root-state-repair-heat-profile-radial-values.v1"},
    "claim_id": {"const": "CBF.T34"},
    "date": {"type": "string"},
    "status": {"type": "string"},
    "source_provenance": {"type": "object"},
    "same_root_commuting_diagram": {"type": "object"},
    "state_space_quadratic_repair": {"type": "object"},
    "action_shadow_bridge": {"type": "object"},
    "heat_profile_selection": {"type": "object"},
    "positive_laplace_measure": {"type": "object"},
    "spectral_moments": {"type": "object"},
    "selected_internal_checkpoint": {"type": "object"},
    "promoted_radial_values": {"type": "object"},
    "typed_no_go_reconciliation": {"type": "object"},
    "parameter_ledger": {"type": "object"},
    "physical_boundary": {"type": "object"},
    "physical_packets_accepted": {"const": 0},
    "physical_packets_total": {"const": 3},
    "physical_rows_accepted": {"const": 0},
    "physical_rows_total": {"const": 7},
    "frontier_delta": {"type": "string"},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "check_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total", "failed"],
      "properties": {
        "passed": {"type": "integer", "minimum": 1},
        "total": {"type": "integer", "minimum": 1},
        "failed": {"type": "array", "maxItems": 0}
      }
    }
  }
}
