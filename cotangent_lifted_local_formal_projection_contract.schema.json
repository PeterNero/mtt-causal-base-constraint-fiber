{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boe.example/mtt/cotangent-lifted-local-formal-projection.v1.schema.json",
  "title": "MTT cotangent-lifted local-formal projection assembly and same-root gluing gate packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "date",
    "status",
    "source_provenance",
    "typed_components",
    "component_product",
    "promotion_criterion",
    "independent_gluing_gates",
    "exact_finite_witness",
    "SP_clause_ledger",
    "parameter_ledger",
    "physical_boundary",
    "component_packets_assembled",
    "component_packets_total",
    "physical_gluing_gates_closed",
    "physical_gluing_gates_total",
    "physical_packets_accepted",
    "physical_packets_total",
    "physical_rows_accepted",
    "physical_rows_total",
    "frontier_delta",
    "checks",
    "check_summary"
  ],
  "properties": {
    "schema": {"const": "boe.mtt.cotangent-lifted-local-formal-projection.v1"},
    "claim_id": {"const": "CBF.T41"},
    "date": {"type": "string"},
    "status": {"type": "string"},
    "source_provenance": {"type": "object"},
    "typed_components": {"type": "object"},
    "component_product": {"type": "object"},
    "promotion_criterion": {"type": "object"},
    "independent_gluing_gates": {"type": "object"},
    "exact_finite_witness": {"type": "object"},
    "SP_clause_ledger": {"type": "object"},
    "parameter_ledger": {"type": "object"},
    "physical_boundary": {"type": "object"},
    "component_packets_assembled": {"const": 4},
    "component_packets_total": {"const": 4},
    "physical_gluing_gates_closed": {"const": 0},
    "physical_gluing_gates_total": {"const": 3},
    "physical_packets_accepted": {"const": 0},
    "physical_packets_total": {"const": 3},
    "physical_rows_accepted": {"const": 0},
    "physical_rows_total": {"const": 7},
    "frontier_delta": {"type": "string"},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "check_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total", "failed"],
      "properties": {
        "passed": {"type": "integer", "minimum": 1},
        "total": {"type": "integer", "minimum": 1},
        "failed": {"type": "array", "maxItems": 0}
      }
    }
  }
}
