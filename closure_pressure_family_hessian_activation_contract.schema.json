{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boe:mtt:closure-pressure-family-hessian-activation:v1",
  "title": "Closure-pressure family-Hessian activation contract",
  "description": "Required source data for promoting a regular nonlinear closure residual into a pressure-activated tangent family Hessian without confusing the result with a physical Yukawa action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "root_source",
    "regular_constraint",
    "pressure_load",
    "curvature",
    "tangent_hessian",
    "descent",
    "physical_typing",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "boe.mtt.closure-pressure-family-hessian-activation.v1"
    },
    "root_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_source_sha256",
        "linear_source",
        "response_source",
        "same_root_intertwiner"
      ],
      "properties": {
        "root_source_sha256": { "$ref": "#/$defs/sha256" },
        "linear_source": { "$ref": "#/$defs/artifact" },
        "response_source": { "$ref": "#/$defs/artifact" },
        "same_root_intertwiner": { "$ref": "#/$defs/artifact" }
      }
    },
    "regular_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["residual", "normal_derivative", "surjective_everywhere"],
      "properties": {
        "residual": { "$ref": "#/$defs/artifact" },
        "normal_derivative": { "const": "I_H16" },
        "surjective_everywhere": { "const": true }
      }
    },
    "pressure_load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["neutral_line", "pressure_value", "physical_scale_selected"],
      "properties": {
        "neutral_line": { "$ref": "#/$defs/artifact" },
        "pressure_value": { "$ref": "#/$defs/artifact" },
        "physical_scale_selected": { "const": false }
      }
    },
    "curvature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["second_derivative", "gauge_equivariant", "shared_circle_equivariant"],
      "properties": {
        "second_derivative": { "$ref": "#/$defs/artifact" },
        "gauge_equivariant": { "const": true },
        "shared_circle_equivariant": { "const": true }
      }
    },
    "tangent_hessian": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bordered_hessian", "reduced_hessian", "family_stabilizer"],
      "properties": {
        "bordered_hessian": { "$ref": "#/$defs/artifact" },
        "reduced_hessian": { "$ref": "#/$defs/artifact" },
        "family_stabilizer": { "enum": ["U(1)", "larger"] }
      }
    },
    "descent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A47_gauge", "A50_shared_circle", "sector_router"],
      "properties": {
        "A47_gauge": { "$ref": "#/$defs/artifact" },
        "A50_shared_circle": { "$ref": "#/$defs/artifact" },
        "sector_router": { "$ref": "#/$defs/artifact" }
      }
    },
    "physical_typing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Lorentz_Higgs_Yukawa_map", "causal_BV_action", "held_out_prediction"],
      "properties": {
        "Lorentz_Higgs_Yukawa_map": { "$ref": "#/$defs/artifact" },
        "causal_BV_action": { "$ref": "#/$defs/artifact" },
        "held_out_prediction": { "$ref": "#/$defs/artifact" }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_action_selected",
        "physical_pressure_selected",
        "physical_Yukawa_values_derived",
        "physical_rows_accepted"
      ],
      "properties": {
        "physical_action_selected": { "const": false },
        "physical_pressure_selected": { "const": false },
        "physical_Yukawa_values_derived": { "const": false },
        "physical_rows_accepted": { "const": 0 }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_or_uri", "sha256", "status"],
      "properties": {
        "path_or_uri": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["exact", "conditional", "selected", "open"] }
      }
    }
  }
}
