{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boe.mtt.dirac-dolbeault-principal-symbol-bridge.v1",
  "title": "CBF.T56 Dirac-Dolbeault principal-symbol bridge packet",
  "type": "object",
  "required": [
    "schema",
    "claim_id",
    "date",
    "status",
    "source_provenance",
    "dirac_symbol_theorem",
    "exact_six_dimensional_clifford_witness",
    "lower_order_stability",
    "T55_composition",
    "q79_evidence_audit",
    "q79_source_contract_update",
    "parameter_ledger",
    "physical_boundary",
    "exact_payload_sha256",
    "checks",
    "check_summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "boe.mtt.dirac-dolbeault-principal-symbol-bridge.v1"},
    "claim_id": {"const": "CBF.T56"},
    "date": {"type": "string"},
    "status": {"type": "string"},
    "source_provenance": {"type": "object"},
    "dirac_symbol_theorem": {"type": "object"},
    "exact_six_dimensional_clifford_witness": {"type": "object"},
    "lower_order_stability": {"type": "object"},
    "T55_composition": {"type": "object"},
    "q79_evidence_audit": {"type": "object"},
    "q79_source_contract_update": {"type": "object"},
    "parameter_ledger": {"type": "object"},
    "physical_boundary": {"type": "object"},
    "exact_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {"type": "object"},
    "check_summary": {
      "type": "object",
      "required": ["passed", "total", "all_passed"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1},
        "all_passed": {"type": "boolean"}
      }
    }
  }
}
