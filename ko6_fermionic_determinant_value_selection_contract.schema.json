{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boe.example/mtt/ko6-fermionic-determinant-value-selection.v1.schema.json",
  "title": "MTT KO6 fermionic determinant finite value-selection packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "date",
    "status",
    "source_provenance",
    "KO6_polarization",
    "chiral_finite_operator",
    "finite_Grassmann_Gaussian",
    "neutral_invertible_chamber",
    "selected_coordinate",
    "dimensionless_branch_values",
    "conditional_one_scale_values",
    "external_mode_obstruction",
    "authority_reconciliation",
    "parameter_ledger",
    "physical_boundary",
    "physical_packets_accepted",
    "physical_packets_total",
    "physical_rows_accepted",
    "physical_rows_total",
    "frontier_delta",
    "checks",
    "check_summary"
  ],
  "properties": {
    "schema": {"const": "boe.mtt.ko6-fermionic-determinant-value-selection.v1"},
    "claim_id": {"const": "CBF.T30"},
    "date": {"type": "string"},
    "status": {"type": "string"},
    "source_provenance": {"type": "object"},
    "KO6_polarization": {"type": "object"},
    "chiral_finite_operator": {"type": "object"},
    "finite_Grassmann_Gaussian": {"type": "object"},
    "neutral_invertible_chamber": {"type": "object"},
    "selected_coordinate": {"type": "object"},
    "dimensionless_branch_values": {"type": "object"},
    "conditional_one_scale_values": {"type": "object"},
    "external_mode_obstruction": {"type": "object"},
    "authority_reconciliation": {"type": "object"},
    "parameter_ledger": {"type": "object"},
    "physical_boundary": {"type": "object"},
    "physical_packets_accepted": {"const": 0},
    "physical_packets_total": {"const": 3},
    "physical_rows_accepted": {"const": 0},
    "physical_rows_total": {"const": 7},
    "frontier_delta": {"type": "string"},
    "checks": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "check_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total", "failed"],
      "properties": {
        "passed": {"type": "integer", "minimum": 1},
        "total": {"type": "integer", "minimum": 1},
        "failed": {"type": "array", "maxItems": 0}
      }
    }
  }
}
